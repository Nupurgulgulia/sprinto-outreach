# Copy to .env.local for local runs. Set the same names in Vercel > Project > Settings > Environment Variables.
# Every key is optional except SEND_TO; the app tells you on screen what is missing.

# --- AI (pick one; Gemini first, OpenRouter as fallback) ---------------------
# Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=
# Optional fallback transport, same model family.
OPENROUTER_API_KEY=
# Defaults to gemini-2.5-flash
AI_MODEL=

# --- Point of contact (Option A: Hunter.io Domain Search, 25 searches/month) --
HUNTER_API_KEY=
# Option B (Apollo, manual): put contacts in data/manual-contacts.json

# --- Send via Resend ----------------------------------------------------------
# API key from https://resend.com/api-keys ("Sending access" is enough).
RESEND_API_KEY=
# Optional. Without a verified domain Resend only allows onboarding@resend.dev,
# and only to the email you signed up to Resend with.
EMAIL_FROM=
# Name in the email sign-off. Optional.
SENDER_NAME=

# THE HARDCODED RECIPIENT. Every email goes here and nowhere else.
# Read on the server only; no field in the UI or API can change it.
# With onboarding@resend.dev this must be your Resend sign-up email.
SEND_TO=
